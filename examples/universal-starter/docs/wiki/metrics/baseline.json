{
  "version": "1.1.0",
  "framework": "OAEF",
  "profile": "strict",
  "stack": "universal",
  "baseline": {
    "coverage": {
      "lines_min_percentage": 95.0,
      "statements_min_percentage": 95.0,
      "functions_min_percentage": 95.0,
      "branches_min_percentage": 90.0
    },
    "duplication": {
      "max_percentage": 3.0,
      "max_fragments": 0,
      "fragment_min_lines": 15
    },
    "violations": {
      "max_analysis_violations": 0,
      "max_unallowed_ignores": 0
    },
    "clean_sizing": {
      "max_oversized_files": 0,
      "file_max_lines": 300,
      "max_oversized_methods": 0,
      "method_max_lines": 50
    },
    "clean_code": {
      "max_single_letter_identifiers": 0,
      "max_cryptic_abbreviations": 0,
      "max_mutable_lazy_initializations": 0,
      "max_dummy_keys": 0,
      "max_raw_prints": 0,
      "max_silent_catches": 0,
      "max_service_locator_leaks": 0,
      "max_nullable_collections": 0,
      "max_unimplemented_placeholders": 0,
      "max_concrete_client_instantiations": 0,
      "max_trigger_matrix_mismatches": 0,
      "max_harness_mirror_mismatches": 0
    },
    "simplicity": {
      "ponytail_debt_markers": "report-only",
      "max_speculative_single_caller_abstractions": "advisory"
    },
    "secret_scanning": {
      "max_detected_secrets": 0
    },
    "exclusions": {
      "coverage": [
        ".g.",
        "/generated/",
        ".min.js",
        "_test.",
        "test/"
      ],
      "clean_sizing": [
        ".g.",
        "/generated/",
        "dist/",
        "build/"
      ],
      "clean_code": [
        ".git/",
        ".github/",
        ".agents/",
        ".oaef/",
        "node_modules/",
        "vendor/",
        "build/",
        "dist/",
        "target/",
        "obj/",
        "tool/",
        "docs/",
        "templates/",
        "examples/",
        "coverage/",
        "generated/",
        "__pycache__/",
        ".venv/",
        "venv/"
      ]
    }
  }
}
