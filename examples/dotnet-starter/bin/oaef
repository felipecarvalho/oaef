#!/usr/bin/env bash
# ==============================================================================
# OAEF CLI Entry Point
# Author & Creator: Felipe Carvalho
# License: Apache License 2.0
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

run_governance() {
  local governance_command="$1"
  shift
  if [ -f "tool/governance.dart" ]; then
    dart run tool/governance.dart "$governance_command" "$@"
  elif [ -f "tool/governance.mjs" ]; then
    node tool/governance.mjs "$governance_command" "$@"
  elif [ -f "tool/governance.py" ]; then
    python3 tool/governance.py "$governance_command" "$@"
  elif [ -f "tool/governance.go" ]; then
    go run tool/governance.go "$governance_command" "$@"
  elif [ -f "tool/governance.rs" ]; then
    local rust_binary=".oaef/governance-rust"
    if [ ! -x "$rust_binary" ] || [ "tool/governance.rs" -nt "$rust_binary" ]; then
      mkdir -p .oaef
      rustc -O tool/governance.rs -o "$rust_binary" >/dev/null || { echo "rustc failed for tool/governance.rs"; exit 1; }
    fi
    "$rust_binary" "$governance_command" "$@"
  elif [ -f "tool/governance.swift" ]; then
    swift tool/governance.swift "$governance_command" "$@"
  elif [ -f "tool/governance.main.kts" ]; then
    # kotlinc parses leading-dash flags before the script, so the command line travels via the environment
    OAEF_GOVERNANCE_ARGS="$governance_command $*" kotlinc -script tool/governance.main.kts
  elif [ -f "tool/Governance.cs" ]; then
    dotnet run --project tool/Governance.csproj "$governance_command" "$@"
  elif [ -f "tool/governance.sh" ]; then
    bash tool/governance.sh "$governance_command" "$@"
  else
    echo "No runtime governance script found in tool/. Run 'oaef init' first."
    exit 1
  fi
}

has_governance_runtime() {
  for candidate in tool/governance.dart tool/governance.mjs tool/governance.py tool/governance.go \
    tool/governance.rs tool/governance.swift tool/governance.main.kts tool/Governance.cs tool/governance.sh; do
    [ -f "$candidate" ] && return 0
  done
  return 1
}

mirror_agents_file() {
  if [ -f "AGENTS.md" ]; then
    {
      echo "<!-- AUTO-GENERATED MIRROR FROM AGENTS.md. DO NOT EDIT DIRECTLY. -->"
      echo "<!-- To modify rules, edit AGENTS.md and run \"oaef sync\". -->"
      echo ""
      cat AGENTS.md
    } > CLAUDE.md
    echo "✅ Synchronized AGENTS.md -> CLAUDE.md"
  fi
}

case "$1" in
  init)
    shift
    "$SCRIPT_DIR/install.sh" "$@"
    ;;
  adopt)
    shift
    "$SCRIPT_DIR/install.sh" --legacy "$@"
    ;;
  upgrade)
    shift
    "$SCRIPT_DIR/install.sh" --upgrade "$@"
    ;;
  export)
    "$SCRIPT_DIR/bundle.sh"
    ;;
  sync)
    echo "🔄 Running OAEF Multi-Tool Synchronization..."
    if has_governance_runtime; then
      run_governance sync
      run_governance skills sync-mirrors || true
    else
      mirror_agents_file
    fi
    ;;
  lint)
    shift
    run_governance lint "$@"
    ;;
  clean-code|governance-check)
    shift
    run_governance clean-code "$@"
    ;;
  audit|quality-gate)
    shift
    run_governance quality-gate "$@"
    ;;
  doctor|conform)
    shift
    run_governance doctor "$@"
    ;;
  ponytail)
    shift
    case "${1:-debt}" in
      audit)
        shift
        run_governance ponytail-audit "$@"
        ;;
      debt|*)
        [ "${1:-}" = "debt" ] && shift
        run_governance ponytail-debt "$@"
        ;;
    esac
    ;;
  skills)
    shift
    case "${1:-audit}" in
      audit)
        shift
        run_governance skills-audit "${1:---selftest}" "$@"
        ;;
      route)
        shift
        run_governance skills-route "$@"
        ;;
      sync-mirrors)
        shift
        run_governance skills sync-mirrors "$@"
        ;;
      *)
        echo "Unknown skills subcommand: $1"
        echo "Usage: oaef skills <audit [--selftest]|route \"<prompt>\"|sync-mirrors [--check]>"
        exit 1
        ;;
    esac
    ;;
  metrics)
    shift
    run_governance metrics "$@"
    ;;
  version|-v|--version)
    cat "$SCRIPT_DIR/VERSION" 2>/dev/null || echo "1.1.0"
    ;;
  *)
    echo "Open Agentic Engineering Framework (OAEF) CLI"
    echo "Usage: oaef <command> [options]"
    echo ""
    echo "Commands:"
    echo "  init        Run the interactive Discovery Interview to bootstrap a repository"
    echo "  adopt       Adopt OAEF into an existing repository (advisory barriers + adoption ledger)"
    echo "  upgrade     Upgrade an earlier OAEF installation in place (user content preserved)"
    echo "  sync        Synchronize AGENTS.md with CLAUDE.md and rebuild the harness skill mirrors"
    echo "  lint        Audit links, cascade references, secrets, suppressions, clean code and skills"
    echo "  clean-code  Run the governance barriers (docs/standards/governance_checks.md)"
    echo "  audit       Execute the multidimensional Quality Gate audit"
    echo "  doctor      Audit OAEF conformance (structure, standards, skills, mirrors, self-test)"
    echo "  ponytail    Report simplicity debt: 'oaef ponytail debt' / 'oaef ponytail audit'"
    echo "  skills      Skill activation: 'audit [--selftest]', 'route \"<prompt>\"', 'sync-mirrors [--check]'"
    echo "  metrics     Display the current baseline thresholds"
    echo "  export      Bundle OAEF into a clean release ZIP archive"
    echo "  version     Display the framework version"
    ;;
esac
