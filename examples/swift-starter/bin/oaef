#!/usr/bin/env bash
# ==============================================================================
# OAEF CLI Entry Point
# Author & Creator: Felipe Carvalho
# License: Apache License 2.0
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

run_governance() {
  local governance_command="$1"
  shift
  if [ -f "tool/governance.dart" ]; then
    dart run tool/governance.dart "$governance_command" "$@"
  elif [ -f "tool/governance.mjs" ]; then
    node tool/governance.mjs "$governance_command" "$@"
  elif [ -f "tool/governance.py" ]; then
    python3 tool/governance.py "$governance_command" "$@"
  elif [ -f "tool/governance.go" ]; then
    go run tool/governance.go "$governance_command" "$@"
  elif [ -f "tool/governance.rs" ]; then
    cargo run --bin governance -- "$governance_command" "$@"
  elif [ -f "tool/governance.swift" ]; then
    swift tool/governance.swift "$governance_command" "$@"
  elif [ -f "tool/governance.main.kts" ]; then
    kotlinc -script tool/governance.main.kts "$governance_command" "$@"
  elif [ -f "tool/Governance.cs" ]; then
    dotnet run --project tool/Governance.csproj "$governance_command" "$@"
  elif [ -f "tool/governance.sh" ]; then
    bash tool/governance.sh "$governance_command" "$@"
  else
    echo "No runtime governance script found in tool/. Run 'oaef init' first."
    exit 1
  fi
}

case "$1" in
  init)
    shift
    "$SCRIPT_DIR/install.sh" "$@"
    ;;
  export)
    "$SCRIPT_DIR/bundle.sh"
    ;;
  sync)
    echo "🔄 Running OAEF Multi-Tool Synchronization..."
    if [ -f "tool/governance.dart" ] || [ -f "tool/governance.mjs" ] || [ -f "tool/governance.py" ] || [ -f "tool/governance.go" ] || [ -f "tool/governance.rs" ] || [ -f "tool/governance.swift" ] || [ -f "tool/governance.main.kts" ] || [ -f "tool/Governance.cs" ] || [ -f "tool/governance.sh" ]; then
      run_governance sync
    else
      # Portable sync: copy AGENTS.md to CLAUDE.md
      if [ -f "AGENTS.md" ]; then
        echo "<!-- AUTO-GENERATED MIRROR FROM AGENTS.md. DO NOT EDIT DIRECTLY. -->" > CLAUDE.md
        cat AGENTS.md >> CLAUDE.md
        echo "✅ Synchronized AGENTS.md -> CLAUDE.md"
      fi
    fi
    ;;
  lint)
    shift
    run_governance lint "$@"
    ;;
  audit|quality-gate)
    shift
    run_governance quality-gate "$@"
    ;;
  doctor|conform)
    shift
    run_governance doctor "$@"
    ;;
  metrics)
    shift
    run_governance metrics "$@"
    ;;
  version|-v|--version)
    cat "$SCRIPT_DIR/VERSION" 2>/dev/null || echo "1.0.0"
    ;;
  *)
    echo "Open Agentic Engineering Framework (OAEF) CLI"
    echo "Usage: oaef <command> [options]"
    echo ""
    echo "Commands:"
    echo "  init        Run the interactive Discovery Interview to bootstrap a repository"
    echo "  sync        Synchronize AGENTS.md with CLAUDE.md and IDE agent mirrors"
    echo "  lint        Audit link integrity, cascade references, and secret scanning"
    echo "  audit       Execute the multidimensional Quality Gate audit"
    echo "  doctor      Audit OAEF conformance (structure, skills, mirrors, community files)"
    echo "  metrics     Display the current baseline thresholds"
    echo "  export      Bundle OAEF into a clean release ZIP archive"
    echo "  version     Display the framework version"
    ;;
esac
